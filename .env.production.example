# Copie para .env.production na raiz do repositório (chmod 600).
# O arquivo real não entra no git. Valores abaixo são de exemplo.
#
# O Compose lê este arquivo com --env-file. Ele NÃO expande ${...} dentro
# dos valores: escreva a URL e os segredos literais.
# SERVER_URL é forçado pelo Compose para https://$CRM_DOMAIN. Mesmo assim
# deixe os dois iguais, e o deploy.sh recusa se divergirem.

# Imagem publicada em ghcr.io/dimitrimuniz-png/twentycrmiosei.
# Use a tag sha-* do workflow "Publish container image" deste commit
# (sha- + os 7 primeiros caracteres do commit). A imagem é multi-arch
# (linux/amd64 e linux/arm64) desde o merge do PR #2.
# sha-9140b02 é multi-arch, mas é anterior a SSO_ALLOWED_EMAIL_DOMAINS.
# Não use latest.
TAG=sha-9140b02

# Subdomínio público. O registro A aponta para o Elastic IP.
CRM_DOMAIN=crm.iosei.co
SERVER_URL=https://crm.iosei.co
# Conta Let's Encrypt. Não precisa receber e-mail do CRM.
ACME_EMAIL=admin@iosei.co

# Express confia no proxy da rede Docker (Caddy). Não exponha o Node direto.
TRUST_PROXY="loopback, linklocal, uniquelocal"

# RDS PostgreSQL 16, banco `default`, TLS obrigatório.
# Senha só com hex (openssl rand -hex 32), sem caracteres especiais.
# Os dois abaixo são exigidos pelo deploy.sh. O certificado do RDS é validado
# com o CA bundle que o deploy.sh baixa (veja DEPLOY_AWS_HANDOFF.md).
PG_DATABASE_URL=postgres://twenty:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef@twenty.xxxxxxxxxxxx.sa-east-1.rds.amazonaws.com:5432/default?sslmode=require
PG_SSL_ALLOW_SELF_SIGNED=true

# Redis roda no Compose. A senha entra no comando do Redis e em REDIS_URL,
# montada pelo Compose como redis://:<senha>@redis:6379. Não defina REDIS_URL aqui.
REDIS_PASSWORD=0123456789abcdef0123456789abcdef

# openssl rand -base64 32. São segredos diferentes. Não reutilize entre ambientes.
# ENCRYPTION_KEY cifra o client secret OIDC. APP_SECRET assina JWT.
ENCRYPTION_KEY=replace_me_openssl_rand_base64_32
# Só na rotação: a ENCRYPTION_KEY anterior. Vazio numa instalação nova.
FALLBACK_ENCRYPTION_KEY=
APP_SECRET=replace_me_openssl_rand_base64_32_different

# s3 vira S_3 no servidor (lodash snake_case). local é o fallback em disco
# (volume server-local-data). Para AWS deixe o endpoint e as chaves vazios:
# o container usa a role da instância. Uma string vazia não é enviada ao SDK.
STORAGE_TYPE=s3
STORAGE_S3_REGION=sa-east-1
STORAGE_S3_NAME=twenty-crm-iosei-prod
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# false: upload passa pelo servidor. true exigiria CORS no bucket.
STORAGE_S3_PRESIGNED_URL_ENABLED=false
# Vídeos do Treinamento ficam neste prefixo do mesmo bucket privado.
# A página assina o download mesmo com PRESIGNED_URL_ENABLED=false.
TRAINING_STORAGE_PREFIX=training

# SMTP. Não use AWS SES: o gate enterprise não foi aberto e a chave não
# deve ser definida. EMAIL_DRIVER=smtp vira SMTP.
# App password do Google: smtp.gmail.com porta 587 (STARTTLS).
# Relay do Workspace: smtp-relay.gmail.com porta 587, com o Elastic IP
# autorizado no Admin ou com usuário e senha.
EMAIL_DRIVER=smtp
EMAIL_FROM_ADDRESS=crm@iosei.co
EMAIL_FROM_NAME="IOSEI CRM"
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=crm@iosei.co
EMAIL_SMTP_PASSWORD=replace_me_google_app_password
EMAIL_SMTP_NO_TLS=false

# Lista exata. O deploy.sh recusa qualquer outro conjunto.
# Vazio no código libera todos os domínios; em produção não pode ficar vazio.
SSO_ALLOWED_EMAIL_DOMAINS=iosei.co,mstecnologia.med.br,i-rad.co

# O primeiro administrador entra com senha (o SSO só existe depois do
# workspace). Não desligue a senha antes disso.
AUTH_PASSWORD_ENABLED=true
IS_EMAIL_VERIFICATION_REQUIRED=true
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true
IS_MULTIWORKSPACE_ENABLED=false
SIGN_IN_PREFILLED=false
IS_BILLING_ENABLED=false
ANALYTICS_ENABLED=false

# Não defina ENTERPRISE_KEY. O deploy.sh aborta se ela existir.
