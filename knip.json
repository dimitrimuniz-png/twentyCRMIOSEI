{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": [
    "packages/twenty-docs",
    "packages/twenty-apps/**",
    "packages/twenty-front-component-renderer"
  ],
  "rules": {
    "binaries": "warn",
    "dependencies": "error",
    "devDependencies": "error",
    "duplicates": "warn",
    "enumMembers": "warn",
    "exports": "warn",
    "files": "error",
    "optionalPeerDependencies": "warn",
    "types": "warn",
    "unlisted": "warn",
    "unresolved": "warn"
  },
  "workspaces": {
    "packages/twenty-server": {
      "entry": [
        "src/main.ts",
        "src/command/command.ts",
        "src/queue-worker/queue-worker.ts",
        "src/database/scripts/*.ts",
        "src/database/clickhouse/migrations/run-migrations.ts",
        "src/database/clickhouse/seeds/run-seeds.ts",
        "src/instrument.ts",
        "lingui.config.ts",
        "scripts/**/*.ts",
        "**/*.spec.ts",
        "**/*.integration-spec.ts",
        "test/integration/graphql/codegen/index.ts",
        "test/integration/utils/setup-test.ts",
        "test/integration/utils/teardown-test.ts",
        "src/database/typeorm/core/legacy-typeorm-migrations-do-not-add/**/*.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
      "jest": [
        "jest.config.mjs",
        "jest-integration.config.ts",
        "jest-integration-secure.config.ts"
      ],
      "ignore": [
        "src/**/constants/seed-project/**",
        "src/database/typeorm/core/migrations/**",
        "**/*.workspace-entity.ts",
        "src/engine/core-modules/logic-function/logic-function-resource/constants/**",
        "src/database/commands/upgrade-version-command/**",
        "src/engine/metadata-modules/*/constants/standard-*-names.ts",
        "src/engine/metadata-modules/*/constants/standard-*-titles.ts",
        "src/engine/core-modules/admin-panel/dtos/models-dev-model-suggestion.dto.ts",
        "src/engine/core-modules/admin-panel/dtos/models-dev-provider-suggestion.dto.ts",
        "src/engine/core-modules/billing/billing.validate.ts",
        "src/engine/core-modules/billing/constants/update-subscription-quantity-job-delay-ms.constant.ts",
        "src/engine/core-modules/billing/dtos/billing-price-licensed.dto.ts",
        "src/engine/core-modules/billing/dtos/billing-price-metered.dto.ts",
        "src/engine/core-modules/billing/dtos/billing-product.dto.ts",
        "src/engine/core-modules/billing/dtos/billing-resource-credit-usage.dto.ts",
        "src/engine/core-modules/billing/dtos/billing-subscription-schedule-phase.dto.ts",
        "src/engine/core-modules/billing/reminders/constants/billing-reminder-sent-keys.constant.ts",
        "src/engine/core-modules/billing/types/base-product-subscription-item.type.ts",
        "src/engine/core-modules/billing/types/billing-meter-price.type.ts",
        "src/engine/core-modules/billing/types/billing-product-metadata.type.ts",
        "src/engine/core-modules/billing/types/billing-subscription-with-schedule.type.ts",
        "src/engine/core-modules/billing/types/credit-availability.type.ts",
        "src/engine/core-modules/billing/types/meter-billing-price-tier.type.ts",
        "src/engine/core-modules/dns-manager/exceptions/dns-manager-exception-filter.ts",
        "src/engine/core-modules/dns-manager/exceptions/dns-manager.exception.ts",
        "src/engine/core-modules/dns-manager/validator/dns-manager.validate.ts",
        "src/engine/core-modules/emailing-domain/constants/community-emailing-domain-drivers.constant.ts",
        "src/engine/core-modules/enterprise/constants/enterprise-public-key.constant.ts",
        "src/engine/core-modules/enterprise/constants/organization-key-validation-cron-pattern.constant.ts",
        "src/engine/core-modules/enterprise/types/organization-key-payload.type.ts",
        "src/engine/core-modules/event-logs/cleanup/constants/event-log-cleanup-workspace-batch-size.constant.ts",
        "src/engine/core-modules/event-logs/event-logs-live.resolver.ts",
        "src/engine/core-modules/event-logs/filters/forbidden-exception-graphql.filter.ts",
        "src/engine/core-modules/usage-limit/types/calendar-period-unit.type.ts",
        "src/engine/core-modules/usage-limit/types/credit-allowance.type.ts",
        "src/engine/core-modules/usage/types/api-type.type.ts",
        "src/engine/core-modules/usage/types/credits-used.type.ts",
        "src/engine/core-modules/usage/types/usage-consumption-totals.type.ts",
        "src/engine/core-modules/usage/utils/to-dollars.util.ts",
        "src/engine/metadata-modules/flat-row-level-permission-predicate/utils/from-create-row-level-permission-predicate-group-input-to-flat-row-level-permission-predicate-group.util.ts",
        "src/engine/metadata-modules/flat-row-level-permission-predicate/utils/from-create-row-level-permission-predicate-input-to-flat-row-level-permission-predicate.util.ts",
        "src/engine/metadata-modules/flat-row-level-permission-predicate/utils/from-update-row-level-permission-predicate-group-input-to-flat-row-level-permission-predicate-group.util.ts",
        "src/engine/metadata-modules/flat-row-level-permission-predicate/utils/from-update-row-level-permission-predicate-input-to-flat-row-level-permission-predicate.util.ts",
        "src/engine/metadata-modules/flat-row-level-permission-predicate/utils/to-row-level-permission-predicate-value.util.ts",
        "src/engine/core-modules/billing-webhook/billing-webhook.controller.ts",
        "src/engine/core-modules/billing-webhook/utils/get-customer-id-from-invoice.util.ts",
        "src/engine/core-modules/billing-webhook/utils/get-subscription-id-from-invoice.util.ts",
        "src/engine/core-modules/cloudflare/controllers/dns-cloudflare.controller.ts",
        "src/engine/core-modules/billing/entities/billing-credit-grant.entity.ts",
        "src/engine/core-modules/billing/enums/billing-webhook-events.enum.ts",
        "src/engine/core-modules/billing/utils/derive-billing-period-transition.util.ts",
        "src/engine/core-modules/billing/utils/is-credit-top-up-invoice.util.ts",
        "src/engine/core-modules/billing/utils/resolve-billing-transition-boundary.util.ts",
        "src/engine/twenty-orm/utils/get-relation-flat-field-metadatas-of-object.util.ts",
        "src/engine/twenty-orm/utils/resolve-unsatisfiable-record-filter-group-ids.util.ts",
        "src/modules/emailing/constants/campaign-batch-variable-tag-pattern.constant.ts",
        "src/modules/emailing/constants/campaign-tracking-tag-prefix-by-message-part.constant.ts",
        "src/modules/emailing/utils/normalize-campaign-recipient-email-address.util.ts"
      ],
      "ignoreDependencies": ["@types/psl", "@node-saml/node-saml"]
    },
    "packages/twenty-front": {
      "entry": [
        "src/index.tsx",
        "src/**/graphql/**/*.{ts,tsx}",
        "src/modules/geo-map/graphql-query/*.{ts,tsx}",
        "vitest.config.ts",
        "lingui.config.ts",
        "nyc.config.cjs"
      ],
      "graphql-codegen": [
        "codegen.cjs",
        "codegen-admin.cjs",
        "codegen-metadata.cjs"
      ],
      "ignore": [
        "src/locales/generated/**",
        ".eloqnt/config.ts",
        "src/modules/object-record/object-filter-dropdown/utils/getCompositeSubFieldType.ts",
        "src/modules/settings/domains/hooks/useCheckCustomDomainValidRecords.ts",
        "src/modules/settings/domains/states/customDomainRecordsState.ts",
        "src/modules/settings/roles/role-permissions/object-level-permissions/record-level-permissions/constants/RecordLevelPermissionPredicateFieldTypes.ts",
        "src/modules/settings/roles/role-permissions/object-level-permissions/record-level-permissions/contexts/RecordLevelPermissionVariablePickerContext.ts",
        "src/modules/settings/security/utils/getColorBySsoIdentityProviderStatus.ts",
        "src/modules/settings/security/utils/guessSsoIdentityProviderIconByUrl.ts"
      ],
      "ignoreDependencies": [
        "@babel/preset-typescript",
        "@storybook/addon-coverage",
        "buffer",
        "emojibase-data",
        "esbuild",
        "playwright",
        "rollup-plugin-node-polyfills"
      ]
    },
    "packages/twenty-oxlint-rules": {
      "entry": ["scripts/**/*.mjs"],
      "ignoreDependencies": ["eslint", "eslint-plugin-lingui", "oxlint"]
    },
    "packages/twenty-ui": {
      "entry": ["scripts/**/*.ts", "docs/**/*.ts"],
      "ignore": ["src/styles/abstracts/**"],
      "ignoreDependencies": ["@storybook/addon-coverage", "@swc/core"]
    }
  }
}
